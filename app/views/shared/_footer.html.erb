<footer class="site-footer">
  <div class="site-footer__top-glow" aria-hidden="true"></div>

  <div class="site-footer__cube-area">
    <div class="site-footer__cube-wrap">
      <%= image_tag "footer-cube.png", alt: "", class: "site-footer__cube", aria: { hidden: true } %>
    </div>
  </div>

  <div class="site-footer__content">
    <a href="#" class="site-footer__brand">
      <%= image_tag "turnip-cake-logo.svg", alt: "", class: "site-footer__brand-icon", aria: { hidden: true } %>
      <span class="site-footer__brand-name">Turnip cake</span>
    </a>

    <div class="site-footer__center">
      <a href="#" class="site-footer__cta">Find events near you</a>

      <div class="site-footer__social" aria-label="Social media">
        <a href="#" class="site-footer__social-link" aria-label="Facebook">
          <i class="bi bi-facebook"></i>
        </a>
        <a href="#" class="site-footer__social-link" aria-label="Instagram">
          <i class="bi bi-instagram"></i>
        </a>
        <a href="#" class="site-footer__social-link" aria-label="X">
          <i class="bi bi-twitter-x"></i>
        </a>
      </div>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <a href="#">About</a>
      <a href="#">Support</a>
      <a href="#">Privacy Policy</a>
    </nav>
  </div>
</footer>
